global proc tacticHandlerInstallerPathProbe() {}

string $source = `whatIs tacticHandlerInstallerPathProbe`;
putenv "TACTIC_HANDLER_INSTALLER_SOURCE" $source;

python("import os, runpy\nsource = os.environ.pop('TACTIC_HANDLER_INSTALLER_SOURCE')\nprefix = 'Mel procedure found in: '\nscript_path = source[len(prefix):] if source.startswith(prefix) else source\ninstaller = runpy.run_path(os.path.join(os.path.dirname(script_path), 'shelf_install.py'))\ninstaller['begin_shelf_install']()\n");
